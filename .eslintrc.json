{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:prettier/recommended"
  ],
  "plugins": ["react"],
  "rules": {
    "no-multiple-empty-lines": ["error", { "max": 1 }]
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
