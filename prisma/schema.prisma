generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Cargo {
  id Int@id @default(autoincrement())
  name  String
  User User[]
}

model Role {
  id                Int       @id @default(autoincrement())
  name  String
  descricao String
  // Relação muitos-para-muitos: cada role pode ter vários usuários
  users      User[]
}

// Model User baseado na migration do Laravel
model User {
  id                Int       @id @default(autoincrement())
  name              String
  avatar            String?
  telefone          String?   // campo opcional
  cpf               String?
  rg                String?
  endereco          String?
  data_contratacao  String?
  data_demissao     String?

  status            Int


  
  email             String    @unique
  email_verified_at DateTime?
  password          String
  roles             Role[]  
  cargoId           Int?      // chave estrangeira opcional
  cargo             Cargo?    @relation(fields: [cargoId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
 
  negocios          Negocio[]  // se desejar relacionar o usuário com os negócios
  agendamento Agendamento[]
  reunioes  Reuniao[]
  simulacoes Simulacao[]

  // Relação de membro de equipe (um usuário pode pertencer a, no máximo, uma equipe)
  equipeId          Int?      
  equipe            Equipe?   @relation("TeamMembers", fields: [equipeId], references: [id])

  // Relação de liderança: cada usuário pode liderar, no máximo, uma equipe
  liderEquipe      Equipe?   @relation("LeaderTeam")
  
  // Added opposite relation for FechamentoUser model
  fechamentoUsers  FechamentoUser[]
}

model Equipe {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  logo        String?
  // leaderId é obrigatório e único para garantir que toda equipe tenha um líder
  liderId    Int      @unique
  lider      User     @relation("LeaderTeam", fields: [liderId], references: [id])
  
  // Membros da equipe (um usuário pode pertencer a apenas uma equipe, e pode ser ou não o líder)
  membros     User[]   @relation("TeamMembers")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


enum NegocioTipo {
  // Substitua os valores abaixo pelos definidos em NegocioTipo do Laravel
  IMOVEL
  CARRO
  MOTO
  CAMINHAO
  TERRENO
  MAQUINARIO
  SERVICO
}

enum NegocioStatus {
  // Substitua os valores abaixo pelos definidos em NegocioStatus do Laravel
  ATIVO
  INATIVO
  VENDIDO
  PERDIDO
}

model Negocio {
  id              Int           @id @default(autoincrement())
     
  titulo          String
  valor           String?       @db.VarChar(20)

  origem String?

  tipo            NegocioTipo
  status          NegocioStatus

  consorciado_id         Int
  consorciado            Lead          @relation(fields: [consorciado_id], references: [id])

      // Nova relação opcional para o conjuge (Lead)
  conjugeId                  Int?   @unique
  conjuge                    Lead?       @relation("FechamentoConjuge", fields: [conjugeId], references: [id])
  
  funil_id        Int
  funil           Funil         @relation(fields: [funil_id], references: [id])
  
  etapa_funil_id  Int
  etapa_funil     EtapaFunil    @relation(fields: [etapa_funil_id], references: [id])
  
  user_id         Int?
  user            User?         @relation(fields: [user_id], references: [id])

  data_criacao    DateTime      @default(now())

  updatedAt       DateTime      @updatedAt

  fechamento      Fechamento?   // Um negócio pode ter 0 ou 1 fechamento

  label  Label[]
  agendamento Agendamento[]
  simulacoes Simulacao[]
}

model Label {
  id              Int           @id @default(autoincrement())
  nome      String? 
  negocio Negocio[]
}


model Lead {
  id             Int      @id @default(autoincrement())
  nome           String   @db.VarChar(254)
  telefone       String   @db.VarChar(32)
  whatsapp       String?  @db.VarChar(32)
  email          String?  @db.VarChar(254)

  // Dados pessoais adicionais
  nome_mae       String?  @db.VarChar(255)
  nome_pai       String?  @db.VarChar(255)
  data_nasc      DateTime @default(now())
  orgao_exp      String?  @db.VarChar(255)
  cpf            String?  @db.VarChar(255)
  rg             String?  @db.VarChar(255)
  data_exp       DateTime? @default(now())
  nacionalidade  String?  @db.VarChar(255)
  naturalidade   String?  @db.VarChar(255)
  genero         String?  @db.VarChar(255)
  estado_civil   String?  @db.VarChar(255)
  
  formacao       String?  @db.VarChar(255)
  profissao      String?  @db.VarChar(255)
  renda_liquida  String?  @db.VarChar(255)

  // Informações de campanha
  data_conversao DateTime? @default(now())
  fonte          String?  @db.VarChar(254)
  campanha       String?  @db.VarChar(254)

  // Endereço
  endereco       String?  @db.VarChar(254)
  numero       String?  @db.VarChar(254)
  bairro       String?  @db.VarChar(254)
  cidade       String?  @db.VarChar(254)
  estado       String?  @db.VarChar(254)
  
  complemento    String?  @db.VarChar(254)
  cep            String?  @db.VarChar(254)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relação: um lead pode estar associado a vários negócios
  negocios       Negocio[]

  // Relação reversa para quando o lead é usado como cônjuge em um Fechamento
  fechamentoConjuge Negocio? @relation("FechamentoConjuge")
}


model Funil {
  id        Int      @id @default(autoincrement())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um funil pode ter várias etapas e negócios
  etapa_funils EtapaFunil[]
  negocios     Negocio[]
}

enum EtapaFunilTipo {
  COMUM
  REUNIAO
  AGENDAMENTO
  FECHAMENTO
}


model EtapaFunil {
  id        Int             @id @default(autoincrement())
  nome      String
  tipo      EtapaFunilTipo  // Novo campo para definir o tipo da etapa
  ordem     Int
  funil_id  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  funil     Funil           @relation(fields: [funil_id], references: [id])
  negocios  Negocio[]
}

model Agendamento {
  id              Int      @id @default(autoincrement())
  dataAgendado    DateTime
  dataAgendamento DateTime @default(now())
  hora            String
  status          String?
  
  negocioId       Int
  negocio         Negocio @relation(fields: [negocioId], references: [id])

  userId          Int
  user            User @relation(fields: [userId], references: [id])

  reuniao     Reuniao?  // Se for 1:1, é um campo opcional

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Reuniao {
  id            Int         @id @default(autoincrement())
  
  userId        Int
  dataReuniao   DateTime @default(now())

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relacionamentos
  agendamentoId Int @unique
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
}

model Fechamento {
  id                         Int         @id @default(autoincrement())
  data_fechamento            DateTime?   // Alteramos para DateTime para facilitar manipulação
  status                     String?     @db.VarChar(255)

  // Dados do Plano Contratado
  grupo                      String?     @db.VarChar(255)   
  cota                       String?     @db.VarChar(255)    
  especie                    String?     @db.VarChar(255)
  marca                      String?     @db.VarChar(255)
  modelo                     String?     @db.VarChar(255)
  tipo_plano                 String?     @db.VarChar(255)
  plano_leve                 String?     @db.VarChar(255)
  seguro_prestamista         String?     @db.VarChar(255)
  codigo_bem                 String?     @db.VarChar(255)
  preco_bem                  Decimal?    @db.Decimal(10,2) // Dinheiro com 2 casas decimais
  duracao_grupo              Int?        // Número de meses
  duracao_plano              Int?        // Número de meses
  grupo_em_formacao          Boolean?    // 0 ou 1
  grupo_em_andamento         Boolean?    // 0 ou 1
  numero_assembleia_adesao   Int?        
  data_assembleia            DateTime?   // Data
  tabela                     String?     @db.VarChar(255) // cima e baixo
  pagamento_incorporado      Decimal?    @db.Decimal(10,2)
  pagamento_ate_contemplacao Decimal?    @db.Decimal(10,2)
  numero_contrato            Int?

  // Forma de Pagamento Inicial
  parcela                    Decimal?    @db.Decimal(10,2)
  parcela_antecipada         Decimal?    @db.Decimal(10,2)
  total_antecipado           Decimal?    @db.Decimal(10,2)
  adesao                     Decimal?    @db.Decimal(10,2)
  primeira_parcela           Decimal?    @db.Decimal(10,2)
  total_pago                 Decimal?    @db.Decimal(10,2)
  forma_pagamento            String?     @db.VarChar(255)

  // Associação com Negócio: um fechamento pertence a um negócio
  negocioId                  Int      @unique
  negocio                    Negocio  @relation(fields: [negocioId], references: [id])

  // Relação many-to-many: Um fechamento pode ter 1 ou mais usuários
  vendedores                 FechamentoUser[]

  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt
}

model FechamentoUser {
  fechamento   Fechamento @relation(fields: [fechamentoId], references: [id])
  fechamentoId Int
  user         User       @relation(fields: [userId], references: [id])
  userId       Int

  // Comissão precisa ser string porque não pode passar Decimal do servidor pro cliente
  comissao    String?     @db.VarChar(10)
  modo        String?     @db.VarChar(255)

  @@id([fechamentoId, userId])
}


model Producao {
  id        Int      @id @default(autoincrement())
  name      String
  startDate DateTime 
  endDate   DateTime 
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Simulacao {
  id             Int                      @id @default(autoincrement())
  tipo           String?                  
  dataProposta   DateTime? 
  negocioId      Int
  userId         Int
  consorcios     SimulacaoConsorcio[]
  financiamentos SimulacaoFinanciamento[]

  // Relações (supondo que existam os modelos Negocio e User)
  negocio        Negocio?                 @relation(fields: [negocioId], references: [id])
  user           User                     @relation(fields: [userId], references: [id])
}

model SimulacaoConsorcio {
  id                      Int      @id @default(autoincrement())
  conTitulo               String? 
  conEmpresa              String?  
  conCredito               Decimal?    @db.Decimal(10,2)
  conAdesao               Decimal?    @db.Decimal(10,2) 
  conEntrada               Decimal?    @db.Decimal(10,2)
  conParcelaCheia          Decimal?    @db.Decimal(10,2)  
  conParcelaReduzida       Decimal?    @db.Decimal(10,2)  
  conLance                Decimal?    @db.Decimal(10,2)  
  conPrazo               Int
  conCreditoPosContemplacao  Decimal?    @db.Decimal(10,2)
  conRendaExigida          Decimal?    @db.Decimal(10,2) 
  conValorPago             Decimal?    @db.Decimal(10,2) 
  conJurosPagos           Decimal?    @db.Decimal(10,2)  

  conParcelasEmbutidas    Int  
  simulacaoId             Int
  simulacao               Simulacao  @relation(fields: [simulacaoId], references: [id])
}

model SimulacaoFinanciamento {
  id              Int      @id @default(autoincrement())
  finTitulo       String?  
  finAmortizacao  String? 
  finEmpresa      String? 
  finCredito       Decimal?    @db.Decimal(10,2)  
  finEntrada       Decimal?    @db.Decimal(10,2)
  finParcelas      Decimal?    @db.Decimal(10,2)  
  finUltimaParcela      Decimal?    @db.Decimal(10,2)  
  finPrazo        Int  
  finRendaExigida  Decimal?    @db.Decimal(10,2)  
  finCartorio      Decimal?    @db.Decimal(10,2) 
  finJurosPagos    Decimal?    @db.Decimal(10,2)  
  finValPagoTotal  Decimal?    @db.Decimal(10,2)  
  simulacaoId     Int
  simulacao       Simulacao @relation(fields: [simulacaoId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}




// ###############################################################################
// ###############################################################################
//  ABAIXO MODELS DO SISTEMA DE EXEMPLO, DELETAR DEPOIS
// ###############################################################################
// ###############################################################################


model Admin {
  id       String @id
  username String @unique
}

model Student {
  id          String       @id
  username    String       @unique
  name        String
  surname     String
  email       String?      @unique
  phone       String?      @unique
  address     String
  img         String?
  bloodType   String
  sex         UserSex
  createdAt   DateTime     @default(now())
  parentId    String
  parent      Parent       @relation(fields: [parentId], references: [id])
  classId     Int
  class       Class        @relation(fields: [classId], references: [id])
  gradeId     Int
  grade       Grade        @relation(fields: [gradeId], references: [id])
  attendances Attendance[]
  results     Result[]
  birthday    DateTime
}

model Teacher {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String?   @unique
  address   String
  img       String?
  bloodType String
  sex       UserSex
  createdAt DateTime  @default(now())
  subjects  Subject[]
  lessons   Lesson[]
  classes   Class[]
  birthday  DateTime
}

model Parent {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String    @unique
  address   String
  createdAt DateTime  @default(now())
  students  Student[]
}

model Grade {
  id    Int @id @default(autoincrement())
  level Int @unique

  students Student[]
  classess Class[]
}

model Class {
  id       Int    @id @default(autoincrement())
  name     String @unique
  capacity Int

  supervisorId  String?
  supervisor    Teacher?       @relation(fields: [supervisorId], references: [id])
  lessons       Lesson[]
  students      Student[]
  gradeId       Int
  grade         Grade          @relation(fields: [gradeId], references: [id])
  events        Event[]
  announcements Announcement[]
}

model Subject {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  teachers Teacher[]
  lessons  Lesson[]
}

model Lesson {
  id        Int      @id @default(autoincrement())
  name      String
  day       Day
  startTime DateTime
  endTime   DateTime

  subjectId   Int
  subject     Subject      @relation(fields: [subjectId], references: [id])
  classId     Int
  class       Class        @relation(fields: [classId], references: [id])
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  exams       Exam[]
  assignments Assignment[]
  attendances Attendance[]
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime

  lessonId Int
  lesson   Lesson   @relation(fields: [lessonId], references: [id])
  results  Result[]
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  startDate DateTime
  dueDate   DateTime

  lessonId Int
  lesson   Lesson   @relation(fields: [lessonId], references: [id])
  results  Result[]
}

model Result {
  id    Int @id @default(autoincrement())
  score Int

  examId       Int?
  exam         Exam?       @relation(fields: [examId], references: [id])
  assignmentId Int?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id])
}

model Attendance {
  id      Int      @id @default(autoincrement())
  date    DateTime
  present Boolean

  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  lessonId  Int
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}