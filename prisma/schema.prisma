generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TenantType {
  MASTER
  SUBMASTER
  REPRESENTATION
}

enum BillingFrequency {
  MENSAL
  TRIMESTRAL
  ANUAL
}

model Tenant {
  id               Int             @id @default(autoincrement())
  name             String
  type             TenantType
  billingFrequency BillingFrequency
  submasterId      Int?
  submaster        Tenant?         @relation("SubmasterRepresentations", fields: [submasterId], references: [id])
  representations  Tenant[]        @relation("SubmasterRepresentations")
  
  indicatedById    Int?
  indicatedBy      Tenant?         @relation("TenantReferrals", fields: [indicatedById], references: [id])
  referrals        Tenant[]        @relation("TenantReferrals")
  
  billing          Billing[]
  users            User[]
  equipes          Equipe[]
  negocios         Negocio[]
  leads            Lead[]
  funis            Funil[]
  etapaFunils      EtapaFunil[]
  agendamentos     Agendamento[]
  reunioes         Reuniao[]
  aprovacoes       Aprovacao[]
  fechamentos      Fechamento[]
  producao         Producao[]
  simulacoes       Simulacao[]
  config           Config[]
  leadImportados   LeadImportado[]
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Billing {
  id         Int      @id @default(autoincrement())

  plan       String   // Nome ou código do plano contratado
  valor      Decimal  // Valor cobrado na cobrança
  discount   Decimal  // Desconto aplicado, se houver

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

    // Associação com o tenant (multi‑tenant)
  tenantId          Int 
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
}


model Cargo {
  id        Int      @id @default(autoincrement())
  name      String
  
  // Campo opcional para definir o "scope" deste cargo (por exemplo, MASTER, REPRESENTATION)
  scope     TenantType?
  
  
  // Se desejar manter a associação direta com User, pode manter:
  users     User[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          Int       @id @default(autoincrement())
  name        String
  descricao   String
  
  // Campo opcional para definir o "scope" deste role (por exemplo, MASTER, REPRESENTATION)
  scope       TenantType?
  
  // Relação many-to-many com Tenant
  
  // Relação com usuários que possuem este Role
  users       User[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Model User baseado na migration do Laravel
model User {
  id                Int       @id @default(autoincrement())
  name              String
  avatar            String?
  telefone          String?  
  cpf               String?
  rg                String?
  endereco          String?
  data_contratacao  String?
  data_demissao     String?

  status            Int

  
  email             String    @unique
  email_verified_at DateTime?
  password          String
  roles             Role[]  
  cargoId           Int?      // chave estrangeira opcional
  cargo             Cargo?    @relation(fields: [cargoId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
 
  negocios          Negocio[]  // se desejar relacionar o usuário com os negócios
  agendamento       Agendamento[]
  reunioes          Reuniao[]
  simulacoes        Simulacao[]
  negocioComentario NegocioComentario[]

  // Relação de membro de equipe (um usuário pode pertencer a, no máximo, uma equipe)
  equipeId          Int?      
  equipe            Equipe?   @relation("TeamMembers", fields: [equipeId], references: [id])

  // Relação de liderança: cada usuário pode liderar, no máximo, uma equipe
  liderEquipe       Equipe?   @relation("LeaderTeam")
  
  // Added opposite relation for FechamentoUser model
  fechamentoUsers   FechamentoUser[]
  
  // Added opposite relation for LeadImportado
  leadImportados LeadImportado[] @relation("UserLeadImportados")

  // Associação com o tenant (multi‑tenant)
  tenantId          Int
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
}

model Equipe {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  logo        String?
  // leaderId é obrigatório e único para garantir que toda equipe tenha um líder
  liderId    Int      @unique
  lider      User     @relation("LeaderTeam", fields: [liderId], references: [id])
  
  // Membros da equipe (um usuário pode pertencer a apenas uma equipe, e pode ser ou não o líder)
  membros     User[]   @relation("TeamMembers")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Equipe pertence a um tenant
  tenantId   Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}


enum NegocioTipo {
  // Substitua os valores abaixo pelos definidos em NegocioTipo do Laravel
  IMOVEL
  CARRO
  MOTO
  CAMINHAO
  TERRENO
  MAQUINARIO
  SERVICO
}

enum NegocioStatus {
  // Substitua os valores abaixo pelos definidos em NegocioStatus do Laravel
  ATIVO
  INATIVO
  VENDIDO
  PERDIDO
}

model Negocio {
  id              Int           @id @default(autoincrement())
     
  titulo          String
  valor           Decimal?      

  origem String?

  tipo            NegocioTipo
  status          NegocioStatus

  consorciado_id         Int
  consorciado            Lead          @relation(fields: [consorciado_id], references: [id])

      // Nova relação opcional para o conjuge (Lead)
  conjugeId                  Int?   @unique
  conjuge                    Lead?       @relation("FechamentoConjuge", fields: [conjugeId], references: [id])
  
  funil_id        Int
  funil           Funil         @relation(fields: [funil_id], references: [id])
  
  etapa_funil_id  Int
  etapa_funil     EtapaFunil    @relation(fields: [etapa_funil_id], references: [id])
  
  userId         Int?
  user            User?         @relation(fields: [userId], references: [id])

  data_criacao    DateTime      @default(now())

  updatedAt       DateTime      @updatedAt

  fechamento      Fechamento?   // Um negócio pode ter 0 ou 1 fechamento

  label  Label[]
  agendamento Agendamento[]
  simulacoes Simulacao[]
  aprovacoes Aprovacao[] @relation("NegocioAprovacao")

  negocioComentario NegocioComentario[]

  upload    Upload[]

  tenantId       Int
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
}

model Label {
  id              Int           @id @default(autoincrement())
  nome      String? 
  negocio Negocio[]
}


model Lead {
  id             Int      @id @default(autoincrement())
  nome           String   
  telefone       String   
  whatsapp       String?  
  email          String?  
  avatar          String?  

  // Dados pessoais adicionais
  nome_mae       String?  
  nome_pai       String?  
  data_nasc      DateTime @default(now())
  orgao_exp      String?  
  cpf            String?  
  rg             String?  
  data_exp       DateTime? @default(now())
  nacionalidade  String?  
  naturalidade   String?  
  genero         String?  
  estado_civil   String?  
  
  formacao       String?  
  profissao      String?  
  renda_liquida  String?  

  // Informações de campanha
  data_conversao DateTime? @default(now())
  fonte          String?  
  campanha       String?  

  // Endereço
  endereco       String?  
  numero       String?  
  bairro       String?  
  cidade       String?  
  estado       String?  
  
  complemento    String?  
  cep            String?  

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relação: um lead pode estar associado a vários negócios
  negocios       Negocio[]

  // Relação reversa para quando o lead é usado como cônjuge em um Fechamento
  fechamentoConjuge Negocio? @relation("FechamentoConjuge")

  tenantId         Int
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
}


model Funil {
  id        Int      @id @default(autoincrement())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um funil pode ter várias etapas e negócios
  etapa_funils EtapaFunil[]
  negocios     Negocio[]

  tenantId  Int
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
}

enum EtapaFunilTipo {
  COMUM
  REUNIAO
  AGENDAMENTO
  FECHAMENTO
}


model EtapaFunil {
  id        Int             @id @default(autoincrement())
  nome      String
  title     String?
  tipo      EtapaFunilTipo  // Novo campo para definir o tipo da etapa
  ordem     Int
  funil_id  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  funil     Funil           @relation(fields: [funil_id], references: [id])
  negocios  Negocio[]

  tenantId Int
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
}

model Agendamento {
  id              Int      @id @default(autoincrement())
  dataAgendado    DateTime
  dataAgendamento DateTime @default(now())
  hora            String
  status          String?
  
  negocioId       Int
  negocio         Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  userId          Int
  user            User @relation(fields: [userId], references: [id])

  reuniao         Reuniao?  // Se for 1:1, é opcional

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenantId        Int
  tenant          Tenant @relation(fields: [tenantId], references: [id])
}

model Reuniao {
  id            Int         @id @default(autoincrement())
  
  userId        Int
  dataReuniao   DateTime @default(now())

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relacionamentos
  agendamentoId Int @unique
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id],  onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])

  tenantId Int
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
}

model Aprovacao {
  id             Int       @id @default(autoincrement())
  data_aprovacao DateTime
  status         String
  negocioId      Int
  negocio        Negocio   @relation("NegocioAprovacao", fields: [negocioId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenantId       Int
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
}

model Fechamento {
  id                         Int         @id @default(autoincrement())
  data_fechamento            DateTime?
  status                     String?

  // Dados do Plano Contratado
  grupo                      String?        
  cota                       String?         
  especie                    String?     
  marca                      String?     
  modelo                     String?     
  tipo_plano                 String?     
  plano_leve                 String?     
  seguro_prestamista         String?     
  codigo_bem                 String?     
  preco_bem                  Decimal?    @db.Decimal(10,2) // Dinheiro com 2 casas decimais
  duracao_grupo              Int?        // Número de meses
  duracao_plano              Int?        // Número de meses
  grupo_em_formacao          Boolean?    // 0 ou 1
  grupo_em_andamento         Boolean?    // 0 ou 1
  numero_assembleia_adesao   Int?        
  data_assembleia            DateTime?   // Data
  tabela                     String?      // cima e baixo
  pagamento_incorporado      Decimal?    @db.Decimal(10,2)
  pagamento_ate_contemplacao Decimal?    @db.Decimal(10,2)
  numero_contrato            Int?

  // Forma de Pagamento Inicial
  parcela                    Decimal?    @db.Decimal(10,2)
  parcela_antecipada         Decimal?    @db.Decimal(10,2)
  total_antecipado           Decimal?    @db.Decimal(10,2)
  adesao                     Decimal?    @db.Decimal(10,2)
  primeira_parcela           Decimal?    @db.Decimal(10,2)
  total_pago                 Decimal?    @db.Decimal(10,2)
  forma_pagamento            String?     

  // Associação com Negócio: um fechamento pertence a um negócio
  negocioId                  Int      @unique
  negocio                    Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  // Relação many-to-many: Um fechamento pode ter 1 ou mais usuários
  vendedores                 FechamentoUser[]

  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  tenantId  Int
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
}

model FechamentoUser {
  fechamento   Fechamento @relation(fields: [fechamentoId], references: [id])
  fechamentoId Int
  user         User       @relation(fields: [userId], references: [id])
  userId       Int

  // Comissão precisa ser string porque não pode passar Decimal do servidor pro cliente
  comissao    Decimal?    @db.Decimal(10,4)   
  modo        String?     

  @@id([fechamentoId, userId])
}


model Producao {
  id        Int      @id @default(autoincrement())
  name      String
  startDate DateTime 
  endDate   DateTime 
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId Int
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
}


model Simulacao {
  id             Int                      @id @default(autoincrement())
  tipo           String?                  
  dataProposta   DateTime? 
  negocioId      Int
  userId         Int
  consorcios     SimulacaoConsorcio[]
  financiamentos SimulacaoFinanciamento[]

  negocio        Negocio?  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id])

  tenantId       Int
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
}

model SimulacaoConsorcio {
  id                      Int      @id @default(autoincrement())
  conTitulo               String? 
  conEmpresa              String?  
  conCredito               Decimal?    @db.Decimal(10,2)
  conAdesao               Decimal?    @db.Decimal(10,2) 
  conEntrada               Decimal?    @db.Decimal(10,2)
  conParcelaCheia          Decimal?    @db.Decimal(10,2)  
  conParcelaReduzida       Decimal?    @db.Decimal(10,2)  
  conLance                Decimal?    @db.Decimal(10,2)  
  conPrazo               Int
  conCreditoPosContemplacao  Decimal?    @db.Decimal(10,2)
  conRendaExigida          Decimal?    @db.Decimal(10,2) 
  conValorPago             Decimal?    @db.Decimal(10,2) 
  conJurosPagos           Decimal?    @db.Decimal(10,2)  

  conParcelasEmbutidas    Int  
  simulacaoId             Int
  simulacao               Simulacao  @relation(fields: [simulacaoId], references: [id])


}

model SimulacaoFinanciamento {
  id              Int      @id @default(autoincrement())
  finTitulo       String?  
  finAmortizacao  String? 
  finEmpresa      String? 
  finCredito       Decimal?    @db.Decimal(10,2)  
  finEntrada       Decimal?    @db.Decimal(10,2)
  finParcelas      Decimal?    @db.Decimal(10,2)  
  finUltimaParcela      Decimal?    @db.Decimal(10,2)  
  finPrazo        Int  
  finRendaExigida  Decimal?    @db.Decimal(10,2)  
  finCartorio      Decimal?    @db.Decimal(10,2) 
  finJurosPagos    Decimal?    @db.Decimal(10,2)  
  finValPagoTotal  Decimal?    @db.Decimal(10,2)  
  simulacaoId     Int
  simulacao       Simulacao @relation(fields: [simulacaoId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Config {
  id          Int      @id @default(autoincrement())
  key         String   
  value       String   // ou use Json para dados mais complexos
  description String?  // opcional, para documentar a configuração
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relação com o tenant
  tenantId Int
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  
  @@unique([tenantId, key])

}

model LeadImportado {
  id            Int      @id @default(autoincrement())
  nome          String   
  telefone      String   @unique   
  email         String?  
  campanha      String? 
  fonte         String? 
  origem        String?
  tipo            NegocioTipo
  
  data_conversao DateTime 

  userId   Int?

  user   User?    @relation("UserLeadImportados", fields: [userId], references: [id])

  tenantId Int
  tenant    Tenant          @relation(fields: [tenantId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


model NegocioComentario {
  id          Int      @id @default(autoincrement())
  comentario  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      Int
  negocioId   Int

  user        User    @relation(fields: [userId], references: [id])
  negocio     Negocio  @relation(fields: [negocioId], references: [id])
}



model Upload {
  id         Int      @id @default(autoincrement())
  fileName   String
  filePath   String
  extension  String?
  fileSize   Int?
  description String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  negocioId  Int
  negocio    Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
}