generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Cargo {
  id Int@id @default(autoincrement())
  name  String
  User User[]
}

model Role {
  id                Int       @id @default(autoincrement())
  name  String
  descricao String
  // Relação muitos-para-muitos: cada role pode ter vários usuários
  users      User[]
}

// Model User baseado na migration do Laravel
model User {
  id                Int       @id @default(autoincrement())
  name              String
  avatar            String?
  telefone          String?   // campo opcional
  cpf               String?
  rg                String?
  endereco          String?
  data_contratacao  String?
  data_demissao     String?

  status            Int
  // Relação com Equipe (opcional)
  equipe_id         Int?
  equipe            Equipe?   @relation(fields: [equipe_id], references: [id])
  
  email             String    @unique
  email_verified_at DateTime?
  password          String
  roles             Role[]  
  cargoId           Int?      // chave estrangeira opcional
  cargo             Cargo?    @relation(fields: [cargoId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
 
  negocios          Negocio[]  // se desejar relacionar o usuário com os negócios
  agendamento Agendamento[]
  reunioes  Reuniao[]
}


// Se você tiver um model de Equipe, defina-o assim:
model Equipe {
  id    Int     @id @default(autoincrement())
  name  String
  emblema String?
  users User[]
}

enum NegocioTipo {
  // Substitua os valores abaixo pelos definidos em NegocioTipo do Laravel
  IMOVEL
  CARRO
  MOTO
  CAMINHAO
  TERRENO
  MAQUINARIO
  SERVICO
}

enum NegocioStatus {
  // Substitua os valores abaixo pelos definidos em NegocioStatus do Laravel
  ATIVO
  INATIVO
  VENDIDO
  PERDIDO
}

model Negocio {
  id              Int           @id @default(autoincrement())
  fechamento      String?       
  titulo          String
  valor           String?       @db.VarChar(20)

  origem String?

  tipo            NegocioTipo
  status          NegocioStatus

  lead_id         Int
  lead            Lead          @relation(fields: [lead_id], references: [id])
  
  funil_id        Int
  funil           Funil         @relation(fields: [funil_id], references: [id])
  
  etapa_funil_id  Int
  etapa_funil     EtapaFunil    @relation(fields: [etapa_funil_id], references: [id])
  
  user_id         Int?
  user            User?         @relation(fields: [user_id], references: [id])
  
  data_criacao    DateTime      @default(now())

  updatedAt       DateTime      @updatedAt

  label  Label[]
  agendamento Agendamento[]
 

}

model Label {
  id              Int           @id @default(autoincrement())
  nome      String? 
  negocio Negocio[]
}


model Lead {
  id             Int      @id @default(autoincrement())
  nome           String   @db.VarChar(254)
  telefone       String   @db.VarChar(32)
  whatsapp       String?  @db.VarChar(32)
  email          String?  @db.VarChar(254)
  data_conversao String?  @db.VarChar(254)
  fonte          String?  @db.VarChar(254)
  campanha       String?  @db.VarChar(254)
  endereco       String?  @db.VarChar(254)
  complemento    String?  @db.VarChar(254)
  cep            String?  @db.VarChar(254)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relação: um lead pode estar associado a vários negócios
  negocios       Negocio[]
}

model Funil {
  id        Int      @id @default(autoincrement())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um funil pode ter várias etapas e negócios
  etapa_funils EtapaFunil[]
  negocios     Negocio[]
}

enum EtapaFunilTipo {
  COMUM
  REUNIAO
  AGENDAMENTO
  FECHAMENTO
}


model EtapaFunil {
  id        Int             @id @default(autoincrement())
  nome      String
  tipo      EtapaFunilTipo  // Novo campo para definir o tipo da etapa
  ordem     Int
  funil_id  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  funil     Funil           @relation(fields: [funil_id], references: [id])
  negocios  Negocio[]
}

model Agendamento {
  id              Int      @id @default(autoincrement())
  dataAgendado    DateTime
  dataAgendamento DateTime @default(now())
  hora            String
  status          String?
  
  negocioId       Int
  negocio         Negocio @relation(fields: [negocioId], references: [id])

  userId          Int
  user            User @relation(fields: [userId], references: [id])

  reuniao     Reuniao?  // Se for 1:1, é um campo opcional

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Reuniao {
  id            Int         @id @default(autoincrement())
  
  userId        Int
  dataReuniao   DateTime @default(now())

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relacionamentos
  agendamentoId Int @unique
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
}










// ###############################################################################
// ###############################################################################
//  ABAIXO MODELS DO SISTEMA DE EXEMPLO, DELETAR DEPOIS
// ###############################################################################
// ###############################################################################


model Admin {
  id       String @id
  username String @unique
}

model Student {
  id          String       @id
  username    String       @unique
  name        String
  surname     String
  email       String?      @unique
  phone       String?      @unique
  address     String
  img         String?
  bloodType   String
  sex         UserSex
  createdAt   DateTime     @default(now())
  parentId    String
  parent      Parent       @relation(fields: [parentId], references: [id])
  classId     Int
  class       Class        @relation(fields: [classId], references: [id])
  gradeId     Int
  grade       Grade        @relation(fields: [gradeId], references: [id])
  attendances Attendance[]
  results     Result[]
  birthday    DateTime
}

model Teacher {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String?   @unique
  address   String
  img       String?
  bloodType String
  sex       UserSex
  createdAt DateTime  @default(now())
  subjects  Subject[]
  lessons   Lesson[]
  classes   Class[]
  birthday  DateTime
}

model Parent {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String    @unique
  address   String
  createdAt DateTime  @default(now())
  students  Student[]
}

model Grade {
  id    Int @id @default(autoincrement())
  level Int @unique

  students Student[]
  classess Class[]
}

model Class {
  id       Int    @id @default(autoincrement())
  name     String @unique
  capacity Int

  supervisorId  String?
  supervisor    Teacher?       @relation(fields: [supervisorId], references: [id])
  lessons       Lesson[]
  students      Student[]
  gradeId       Int
  grade         Grade          @relation(fields: [gradeId], references: [id])
  events        Event[]
  announcements Announcement[]
}

model Subject {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  teachers Teacher[]
  lessons  Lesson[]
}

model Lesson {
  id        Int      @id @default(autoincrement())
  name      String
  day       Day
  startTime DateTime
  endTime   DateTime

  subjectId   Int
  subject     Subject      @relation(fields: [subjectId], references: [id])
  classId     Int
  class       Class        @relation(fields: [classId], references: [id])
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  exams       Exam[]
  assignments Assignment[]
  attendances Attendance[]
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime

  lessonId Int
  lesson   Lesson   @relation(fields: [lessonId], references: [id])
  results  Result[]
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  startDate DateTime
  dueDate   DateTime

  lessonId Int
  lesson   Lesson   @relation(fields: [lessonId], references: [id])
  results  Result[]
}

model Result {
  id    Int @id @default(autoincrement())
  score Int

  examId       Int?
  exam         Exam?       @relation(fields: [examId], references: [id])
  assignmentId Int?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id])
}

model Attendance {
  id      Int      @id @default(autoincrement())
  date    DateTime
  present Boolean

  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  lessonId  Int
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}